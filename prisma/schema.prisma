generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  password  String?
  role      Role       @default(VIEWER)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  classeurs Classeur[]

  @@map("users")
}

model Cycle {
  id          String           @id @default(cuid())
  code        String           @unique
  label       String
  disciplines Discipline[]
  niveaux     NiveauScolaire[]

  @@map("cycles")
}

model NiveauScolaire {
  id        String     @id @default(cuid())
  code      String     @unique
  label     String
  ordre     Int
  cycleId   String
  classeurs Classeur[]
  sequences Sequence[]
  cycle     Cycle      @relation(fields: [cycleId], references: [id])

  @@map("niveaux_scolaires")
}

model AnneeScolaire {
  id        String     @id @default(cuid())
  label     String     @unique
  debut     Int
  fin       Int
  classeurs Classeur[]
  periodes  Periode[]

  @@map("annees_scolaires")
}

model Periode {
  id              String        @id @default(cuid())
  label           String
  dateDebut       DateTime
  dateFin         DateTime
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  sequences       Sequence[]

  @@map("periodes")
}

model Discipline {
  id        String      @id @default(cuid())
  label     String
  cycleId   String
  cycle     Cycle       @relation(fields: [cycleId], references: [id])
  domaines  Domaine[]
  matieres  Matiere[]
  sequences Sequence[]
  fiches    Fiche[]

  @@map("disciplines")
}

model Domaine {
  id           String        @id @default(cuid())
  label        String
  disciplineId String
  matiereId    String?
  discipline   Discipline    @relation(fields: [disciplineId], references: [id])
  matiere      Matiere?      @relation(fields: [matiereId], references: [id])
  sousDomaines SousDomaine[]
  sequences    Sequence[]
  fiches       Fiche[]

  @@map("domaines")
}

model SousDomaine {
  id        String      @id @default(cuid())
  code      String?     @unique
  label     String
  domaineId String
  matiereId String?
  domaine   Domaine     @relation(fields: [domaineId], references: [id])
  matiere   Matiere?    @relation(fields: [matiereId], references: [id])
  objectifs Objectif[]
  sequences Sequence[]
  fiches    Fiche[]

  @@map("sous_domaines")
}

model Classeur {
  id                 String         @id @default(cuid())
  titre              String
  userId             String
  niveauId           String
  anneeScolaireId    String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  anneeScolaire      AnneeScolaire  @relation(fields: [anneeScolaireId], references: [id])
  niveau             NiveauScolaire @relation(fields: [niveauId], references: [id])
  user               User           @relation(fields: [userId], references: [id])
  matieres           Matiere[]
  fichesSansSequence Fiche[]

  @@map("classeurs")
}

model Matiere {
  id                 String        @id @default(cuid())
  titre              String
  classeurId         String
  disciplineId       String?
  periodesVisibles   String[]
  domaineIdsVisibles String[]
  ordre              Int
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  classeur           Classeur      @relation(fields: [classeurId], references: [id], onDelete: Cascade)
  discipline         Discipline?   @relation(fields: [disciplineId], references: [id])
  domaines           Domaine[]
  sousDomaines       SousDomaine[]
  sequences          Sequence[]

  @@map("matieres")
}

model Sequence {
  id                String          @id @default(cuid())
  titre             String
  matiereId         String
  periodeId         String?
  objectifs         String?
  ordre             Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  matiere           Matiere         @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  periode           Periode?        @relation(fields: [periodeId], references: [id], onDelete: SetNull)
  niveaux           NiveauScolaire[]
  disciplines       Discipline[]
  domaines          Domaine[]
  sousDomaines      SousDomaine[]
  objectifsLearning Objectif[]
  fiches            Fiche[]

  @@map("sequences")
}

model Fiche {
  id           String        @id @default(cuid())
  titre        String
  sequenceId   String?
  classeurId   String?
  ordre        Int
  objectifs    String?
  materiels    String[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sequence     Sequence?     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  classeur     Classeur?     @relation(fields: [classeurId], references: [id], onDelete: Cascade)
  phases       Phase[]
  disciplines  Discipline[]
  domaines     Domaine[]
  sousDomaines SousDomaine[]

  @@map("fiches")
}

model Phase {
  id          String   @id @default(cuid())
  ficheId     String
  titre       String   @default("")
  duree       Int?
  description Json
  ordre       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fiche       Fiche    @relation(fields: [ficheId], references: [id], onDelete: Cascade)

  @@map("phases")
}

model Objectif {
  id           String      @id @default(cuid())
  code         String?     @unique
  label        String
  sousDomainId String
  sousDomain   SousDomaine @relation(fields: [sousDomainId], references: [id])
  sequences    Sequence[]

  @@map("objectifs")
}

enum Role {
  ADMIN
  MANAGER
  CONTRIBUTOR
  VIEWER
}
