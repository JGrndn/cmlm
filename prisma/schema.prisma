generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  password  String?
  role      Role       @default(VIEWER)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  classeurs Classeur[]

  @@map("users")
}

model Cycle {
  id       String           @id @default(cuid())
  code     String           @unique
  label    String
  domaines Domaine[]
  niveaux  NiveauScolaire[]

  @@map("cycles")
}

model NiveauScolaire {
  id        String     @id @default(cuid())
  code      String     @unique
  label     String
  ordre     Int
  cycleId   String
  classeurs Classeur[]
  cycle     Cycle      @relation(fields: [cycleId], references: [id])

  @@map("niveaux_scolaires")
}

model AnneeScolaire {
  id        String     @id @default(cuid())
  label     String     @unique
  debut     Int
  fin       Int
  classeurs Classeur[]

  @@map("annees_scolaires")
}

model Domaine {
  id           String        @id @default(cuid())
  label        String
  cycleId      String
  cycle        Cycle         @relation(fields: [cycleId], references: [id])
  sousDomaines SousDomaine[]

  @@map("domaines")
}

model SousDomaine {
  id        String    @id @default(cuid())
  label     String
  domaineId String
  matieres  Matiere[]
  domaine   Domaine   @relation(fields: [domaineId], references: [id])

  @@map("sous_domaines")
}

model Classeur {
  id              String         @id @default(cuid())
  titre           String
  userId          String
  niveauId        String
  anneeScolaireId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  anneeScolaire   AnneeScolaire  @relation(fields: [anneeScolaireId], references: [id])
  niveau          NiveauScolaire @relation(fields: [niveauId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
  matieres        Matiere[]

  @@map("classeurs")
}

model Matiere {
  id           String       @id @default(cuid())
  titre        String
  classeurId   String
  sousDomainId String?
  ordre        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  classeur     Classeur     @relation(fields: [classeurId], references: [id], onDelete: Cascade)
  sousDomaine  SousDomaine? @relation(fields: [sousDomainId], references: [id])
  sequences    Sequence[]

  @@map("matieres")
}

model Sequence {
  id        String   @id @default(cuid())
  titre     String
  matiereId String
  periode   Periode?
  objectifs String?
  ordre     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seances   Seance[]
  matiere   Matiere  @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@map("sequences")
}

model Seance {
  id         String    @id @default(cuid())
  titre      String
  sequenceId String
  date       DateTime?
  ordre      Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  fiches     Fiche[]
  sequence   Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@map("seances")
}

model Fiche {
  id        String   @id @default(cuid())
  titre     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ordre     Int
  seanceId  String
  seance    Seance   @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  items     Item[]

  @@map("fiches")
}

model Item {
  id        String   @id @default(cuid())
  ficheId   String
  ordre     Int
  contenu   Json
  createdAt DateTime @default(now())
  duree     Int?
  fiche     Fiche    @relation(fields: [ficheId], references: [id], onDelete: Cascade)

  @@map("items")
}

enum Role {
  ADMIN
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum Periode {
  P1
  P2
  P3
  P4
  P5
}
